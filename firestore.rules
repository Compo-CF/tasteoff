rules_version = '2';
// tasteoff Firestore security rules.
// Judges are signed in anonymously (no passwords), so we require an auth token
// to read/write. This blocks unauthenticated internet traffic while keeping the
// "pick your name" UX. The admin/results passcodes are enforced client-side as a
// convenience gate (not hard security). For stronger protection, add Firebase
// App Check and/or move writes behind Cloud Functions (requires the Blaze plan).
service cloud.firestore {
  match /databases/{database}/documents {
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /scores/{scoreId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }
  }
}
