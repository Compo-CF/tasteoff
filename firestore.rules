rules_version = '2';
// tasteoff Firestore security rules.
// Judges are signed in anonymously (no passwords), so we require an auth token
// to read/write. This blocks unauthenticated internet traffic while keeping the
// "pick your name" UX. The admin/results passcodes are enforced client-side as a
// convenience gate (not hard security). For stronger protection, add Firebase
// App Check and/or move writes behind Cloud Functions (requires the Blaze plan).
service cloud.firestore {
  match /databases/{database}/documents {

    // Events + everything under them (scores, People's Choice tally, etc.)
    match /events/{eventId} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Master judge roster
    match /judges/{judgeId} {
      allow read, write: if request.auth != null;
    }

    // Saved event-type templates
    match /templates/{templateId} {
      allow read, write: if request.auth != null;
    }

    // Volunteer sign-ups (public form). Write-only from the client: anyone
    // signed in (anonymously) can SUBMIT a signup, but no one can read, list,
    // edit or delete others' entries — so contact info can't be scraped from
    // the browser. View submissions in the Firebase console (Firestore >
    // volunteers) or export via an authenticated admin/CLI.
    match /volunteers/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
